# dependencies and build output (anchored to the root so same-named folders are not ignored)
/node_modules/
/dist/
/.astro/

# Playwright output, and the `test:visual` reference screenshots: they weigh about 12 MB per
# set and depend on each system, so they are generated locally with `npm run test:visual:update`
/test-results/
/playwright-report/
/blob-report/
/tests/e2e/*-snapshots/

coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

.claude/

.DS_Store
Thumbs.db
