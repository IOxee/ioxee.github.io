# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = false
insert_final_newline = false

# YAML does not allow tabs for indentation: with them, a misplaced value breaks the build.
[*.{yaml,yml}]
indent_style = space
insert_final_newline = true