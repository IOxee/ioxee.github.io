---
import '../styles/folder.css';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

// The script runs in the browser and has no access to `ui.ts`: the texts travel in attributes.
const labels = {
	'data-status-cover': t(locale, 'folder.statusCover'),
	'data-status-one': t(locale, 'folder.statusOne'),
	'data-status-two': t(locale, 'folder.statusTwo'),
};
---

<div
	class="folder"
	data-folder
	data-scroll="off"
	data-open="false"
	data-at-end="false"
	data-back-cover="false"
	{...labels}
>
	<p
		class="visually-hidden"
		data-announce
		aria-live="polite"
		aria-atomic="true"
	></p>
	<p id="folder-help" class="folder-help visually-hidden">
		{t(locale, 'folder.help')}
	</p>

	<div class="track" data-track>
		<div class="stage" data-stage>
			<div
				class="viewport"
				data-viewport
				role="group"
				aria-label={t(locale, 'folder.label')}
				aria-describedby="folder-help"
				aria-keyshortcuts="ArrowLeft ArrowRight PageUp PageDown Home End"
				tabindex="0"
			>
				{/*
					For screen readers and voice control, which send neither arrows nor gestures. They are not visible
					(the folder has no buttons) and are not in the Tab order.
				*/}
				<button
					type="button"
					class="visually-hidden"
					data-turn="prev"
					tabindex="-1"
				>
					{t(locale, 'folder.prev')}
				</button>
				<button
					type="button"
					class="visually-hidden"
					data-turn="next"
					tabindex="-1"
				>
					{t(locale, 'folder.next')}
				</button>
				<div class="spread" data-spread>
					<div class="stack">
						<slot />
						<div class="backcover" aria-hidden="true"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import {
		type Layout,
		pageAtPosition,
		pagesAtPosition,
		positionCount,
		positionOfPage,
	} from '../lib/book';
	import {
		gestureAction,
		pageForHash,
		pageForPosition,
		readingStatus,
		shownProgress,
	} from '../lib/folder-view';
	import {
		type AnchoredPage,
		MAX_FIT_SCALE,
		MIN_FIT_SCALE,
		type PagerAction,
		clampIndex,
		fitScale,
		indexForHash,
		isNear,
		keyAction,
		scrollOffsetFor,
		scrollProgress,
		scrollStep,
		sectionAt,
		settleTarget,
		sheetStates,
		turn,
	} from '../lib/pager';
	import type { SectionId } from '../lib/sections';

	interface GoOptions {
		focus?: boolean;
		syncHash?: boolean;
		/** No animation or announcement: on load, with the URL anchor. */
		instant?: boolean;
		/** The command comes from the page's own scroll: there is no need to scroll it again. */
		fromScroll?: boolean;
	}

	interface Parts {
		folder: HTMLElement;
		pages: HTMLElement[];
		leaves: HTMLElement[];
		viewport: HTMLElement;
		spread: HTMLElement;
		track: HTMLElement;
		announce: HTMLElement;
		turners: HTMLButtonElement[];
		bar: HTMLElement | null;
		foot: HTMLElement | null;
		navLinks: HTMLAnchorElement[];
	}

	// Same threshold as the CSS: from here two pages fit and the folder is shown open.
	const WIDE = '(min-width: 60rem)';
	// How long to wait after the last page change before announcing it: this way a long jump does not fire one announcement per sheet.
	const ANNOUNCE_DELAY = 300;
	// How long, when entering through an anchor, to watch that the browser does not leave the folder out of place.
	const LANDING_WINDOW = 3000;
	// The browser reports (`scrollend`) when scrolling stops, but not all of them do (Firefox announces it and
	// does not send it after a wheel): it also waits for a while to pass without the scroll moving.
	const HAS_SCROLLEND = 'onscrollend' in window;
	const SETTLE_IDLE = 120;
	// How long to wait for a scroll requested by the folder itself to arrive before giving it up as cut short.
	const HEADING_PATIENCE = 2000;

	function throttled(work: () => void): () => void {
		let queued = false;

		return () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				work();
			});
		};
	}

	const afterPaint = (callback: () => void) =>
		requestAnimationFrame(() => requestAnimationFrame(callback));

	function findParts(folder: HTMLElement): Parts | null {
		const one = (selector: string) =>
			folder.querySelector<HTMLElement>(selector);
		const viewport = one('[data-viewport]');
		const spread = one('[data-spread]');
		const track = one('[data-track]');
		const announce = one('[data-announce]');
		const pages = [...folder.querySelectorAll<HTMLElement>('[data-page]')];
		if (!viewport || !spread || !track || !announce) return null;
		if (pages.length === 0) return null;

		return {
			folder,
			pages,
			leaves: [...folder.querySelectorAll<HTMLElement>('[data-leaf]')],
			viewport,
			spread,
			track,
			announce,
			turners: [
				...folder.querySelectorAll<HTMLButtonElement>('[data-turn]'),
			],
			bar: document.querySelector<HTMLElement>('[data-site-bar]'),
			foot: document.querySelector<HTMLElement>('body > footer'),
			navLinks: [
				...document.querySelectorAll<HTMLAnchorElement>(
					'[data-site-nav] a[href^="#"]',
				),
			],
		};
	}

	class FolderView {
		private readonly parts: Parts;
		/** The page the reading is on. In spreads it is the right one, unless the left one was requested. */
		private page = 0;
		/** The page that was requested (tab, anchor, key): it takes precedence over the right one if it is the left one. */
		private preferred: number | null = null;
		/** Page to move focus to as soon as it is visible: with scroll, the turn takes a while to arrive. */
		private pendingFocus: number | null = null;
		private layout: Layout;
		private scrollMode = false;
		private step = scrollStep(innerHeight);
		private pin = 0;
		private foot = 0;
		/** The reading point where the scroll was before moving: that is how we know which way it is going. */
		private rest = 0;
		private settleTimer = 0;
		/** A finger is resting: the scroll is not stopped even if it does not move, and nothing is settled. */
		private holding = false;
		/**
		 * Where a scroll requested by the folder is going (a tab, a key, its own settling) and
		 * since when. If another command cuts it short, the browser reports that "the scroll stopped" halfway:
		 * that is not a rest, and settling the sheet there would divert the new command.
		 */
		private heading: { top: number; since: number } | null = null;
		private announceTimer = 0;
		private markedSection: SectionId | null = null;
		private readonly plan: AnchoredPage[];
		private readonly total: number;
		private readonly reduceMotion = matchMedia(
			'(prefers-reduced-motion: reduce)',
		);
		private readonly wide = matchMedia(WIDE);

		constructor(parts: Parts) {
			this.parts = parts;
			this.total = parts.pages.length;
			this.plan = parts.pages.map((element) => ({
				section: (element.dataset.section ?? 'home') as SectionId,
				anchor: element.dataset.anchor === 'true',
			}));
			this.layout = this.wide.matches ? 'spread' : 'single';
		}

		start(): void {
			this.tag();
			this.listen();

			// Only a folder anchor counts: with no anchor, or another one (`#contenido`), it starts at the cover.
			const landed = location.hash
				? indexForHash(location.hash, this.plan)
				: null;
			this.apply(landed ?? 0, { instant: true, syncHash: false });
			this.measure();
			if (landed !== null) this.settleLanding(landed);

			// It is already in place: the footer, which was hidden until now, can be shown without jumping.
			document.documentElement.dataset.folderReady = '';
		}

		private get position(): number {
			return positionOfPage(this.page, this.layout);
		}

		private get count(): number {
			return positionCount(this.total, this.layout);
		}

		// Data of each sheet and page for the CSS. Set through the CSSOM: the CSP only allows `--tilt` inline.
		private tag(): void {
			const { folder, leaves, pages } = this.parts;
			folder.style.setProperty('--pages', String(this.total));
			folder.style.setProperty('--leaves', String(leaves.length));
			leaves.forEach((leaf, index) =>
				leaf.style.setProperty('--k', String(index)),
			);
			pages.forEach((element, index) => {
				element.style.setProperty('--i', String(index));
				element.tabIndex = -1;
			});
		}

		private render(announce: boolean): void {
			const at = this.position;
			const { left, right } = pagesAtPosition(
				at,
				this.total,
				this.layout,
			);

			this.paintSheets(left, right);
			const { dataset } = this.parts.folder;
			dataset.open = String(at > 0);
			dataset.atEnd = String(at === this.count - 1);
			dataset.backCover = String(
				this.layout === 'spread' && at > 0 && right === null,
			);
			this.markTab();
			if (announce) this.announceSoon();
			this.focusPending(left, right);
		}

		private paintSheets(left: number | null, right: number | null): void {
			const states = sheetStates(this.page, this.total);
			// Turned sheets, according to the spreads: with the folder open it decides what is seen on the left.
			const turned = positionOfPage(this.page, 'spread');

			this.parts.pages.forEach((element, index) => {
				element.dataset.state = states[index] ?? 'future';
				element.toggleAttribute('data-near', isNear(index, this.page));
				element.inert = index !== left && index !== right;
			});
			this.parts.leaves.forEach((leaf, index) => {
				leaf.toggleAttribute('data-turned', index < turned);
				leaf.toggleAttribute(
					'data-near',
					index >= turned - 2 && index <= turned + 1,
				);
			});
		}

		private markTab(): void {
			const section = sectionAt(this.page, this.plan);
			if (section === this.markedSection) return;
			this.markedSection = section;

			for (const link of this.parts.navLinks) {
				const current =
					section !== 'home' && link.hash === `#${section}`;
				if (!current) {
					link.removeAttribute('aria-current');
					continue;
				}

				link.setAttribute('aria-current', 'location');
				const nav = link.closest('nav');
				if (nav && nav.scrollWidth > nav.clientWidth) {
					const box = nav.getBoundingClientRect();
					const own = link.getBoundingClientRect();
					nav.scrollLeft +=
						own.left - box.left - (box.width - own.width) / 2;
				}
			}
		}

		private announceSoon(): void {
			const { folder, pages, announce } = this.parts;
			const sentence = readingStatus(
				this.page,
				this.total,
				this.layout,
				pages[this.page]?.dataset.title ?? '',
				{
					cover: folder.dataset.statusCover ?? '',
					one: folder.dataset.statusOne ?? '',
					two: folder.dataset.statusTwo ?? '',
				},
			);
			clearTimeout(this.announceTimer);
			this.announceTimer = window.setTimeout(() => {
				announce.textContent = sentence;
			}, ANNOUNCE_DELAY);
		}

		private focusPending(left: number | null, right: number | null): void {
			const target = this.pendingFocus;
			if (target === null || (target !== left && target !== right))
				return;

			this.pendingFocus = null;
			this.parts.pages[target]?.focus({ preventScroll: true });
		}

		private syncHash(): void {
			const section = sectionAt(this.page, this.plan);
			const url = new URL(location.href);
			url.hash = section === 'home' ? '' : section;
			if (url.href !== location.href) history.replaceState(null, '', url);
		}

		private trackTop(): number {
			return this.parts.track.getBoundingClientRect().top + scrollY;
		}

		/** How much the page has scrolled since the folder was pinned. */
		private scrolled(): number {
			return scrollY - (this.trackTop() - this.pin);
		}

		private offsetOfPosition(position: number): number {
			return (
				this.trackTop() -
				this.pin +
				scrollOffsetFor(position, this.step)
			);
		}

		private offsetOf(page: number): number {
			return this.offsetOfPosition(positionOfPage(page, this.layout));
		}

		private scrollToPage(target: number, smooth: boolean): void {
			this.scrollTop(this.offsetOf(target), smooth);
		}

		// Every scroll the folder requests goes through here: that way we know where it was headed if it is cut off.
		private scrollTop(top: number, smooth: boolean): void {
			const animated = smooth && !this.reduceMotion.matches;
			this.heading = animated ? { top, since: performance.now() } : null;
			scrollTo({ top, behavior: animated ? 'smooth' : 'instant' });
		}

		private scheduleSettle(): void {
			clearTimeout(this.settleTimer);
			this.settleTimer = window.setTimeout(
				() => this.settle(),
				SETTLE_IDLE,
			);
		}

		private onScroll(): void {
			if (!this.scrollMode) return;

			this.scheduleSettle();

			const progress = scrollProgress(
				this.scrolled(),
				this.step,
				this.count,
			);
			this.parts.folder.style.setProperty(
				'--progress',
				shownProgress(progress, this.reduceMotion.matches).toFixed(3),
			);

			const at = Math.round(progress);
			if (at === this.position) return;

			this.apply(
				pageForPosition(at, this.preferred, this.total, this.layout),
				{ fromScroll: true },
			);
		}

		// How much to scale the folder to fill the screen between the bar and the footer; `null` if it does not fit legibly.
		private fit(natural: number): number | null {
			const { viewport, spread } = this.parts;
			const padding = getComputedStyle(viewport);
			const chrome =
				Number.parseFloat(padding.paddingTop) +
				Number.parseFloat(padding.paddingBottom);
			// `offsetWidth` does not count the scale: it is the natural width of the pages.
			const widest = viewport.clientWidth / spread.offsetWidth;

			return fitScale(
				innerHeight - this.pin - this.foot - chrome,
				natural,
				MIN_FIT_SCALE,
				Math.min(MAX_FIT_SCALE, widest),
			);
		}

		/**
		 * Decides whether the folder fills the screen (shrunk or enlarged) or does not fit, and measures the track.
		 * With `reanchor` (when the layout changes) the scroll is put back on the page that was being read
		 * before letting the scroll decide: otherwise the old position would give another page.
		 */
		private measure(reanchor = false): void {
			const { folder, spread, bar, foot } = this.parts;
			const wasOn = this.scrollMode;
			// Everything is measured first and changed afterwards: a measurement taken halfway would force a layout with the
			// mode already changed.
			this.pin = Math.round(bar?.getBoundingClientRect().height ?? 0);
			// The footer is pinned at its minimum height: this way the measurement does not depend on whether it is already pinned or not.
			this.foot = foot
				? Math.round(
						Number.parseFloat(getComputedStyle(foot).minHeight) ||
							0,
					)
				: 0;
			// `offsetHeight` does not count the scale: it is the natural height of the pages.
			const natural = spread.offsetHeight;
			const scale = this.fit(natural);

			this.scrollMode = scale !== null;
			this.step = scrollStep(innerHeight);
			folder.style.setProperty('--pin-top', `${this.pin}px`);
			folder.style.setProperty('--fit', (scale ?? 1).toFixed(4));
			folder.style.setProperty('--spread-h', `${natural}px`);
			folder.style.setProperty('--positions', String(this.count));
			folder.style.setProperty('--step', `${this.step}px`);
			folder.style.setProperty(
				'--stage-h',
				`${Math.max(innerHeight - this.pin - this.foot, 0)}px`,
			);
			folder.dataset.scroll = this.scrollMode ? 'on' : 'off';

			if (!this.scrollMode) return;
			if (this.page > 0 && (reanchor || !wasOn)) {
				this.scrollToPage(this.page, false);
			}
			if (reanchor || !wasOn) this.rest = this.restingPosition();
			this.onScroll();
		}

		private restingPosition(): number {
			return clampIndex(
				Math.round(
					scrollProgress(this.scrolled(), this.step, this.count),
				),
				this.count,
			);
		}

		/**
		 * When the scroll stops between two sheets, the folder finishes turning the one that was being rotated, in the direction it
		 * was going. With browser snap points (`scroll-snap`) it would go to the nearest one, and a wheel tick would send it back to where it
		 * was.
		 */
		private settle(): void {
			if (!this.scrollMode || this.holding) return;

			// A scroll requested by the folder that is still on its way is not stopped: wait for it to arrive.
			const { heading } = this;
			if (heading) {
				const arriving =
					performance.now() - heading.since < HEADING_PATIENCE &&
					Math.abs(scrollY - heading.top) > 1;
				if (arriving) return;
				this.heading = null;
			}

			const at = this.scrolled() / this.step;
			const target = settleTarget(at, this.rest, this.count);
			if (target === null) {
				this.rest = this.restingPosition();
				return;
			}

			const top = this.offsetOfPosition(target);
			if (Math.abs(scrollY - top) <= 1) {
				this.rest = target;
				return;
			}

			// On arrival, the scroll stops again and this function records the point as the resting one.
			this.scrollTop(top, true);
			if (this.reduceMotion.matches) this.rest = target;
		}

		// Without scroll, after going to another sheet from a link, scroll up to see the folder if it ended up off screen.
		private reveal(): void {
			const { folder } = this.parts;
			const top = folder.getBoundingClientRect().top;
			if (top >= this.pin && top < innerHeight * 0.6) return;

			folder.scrollIntoView({
				block: 'start',
				behavior: this.reduceMotion.matches ? 'auto' : 'smooth',
			});
		}

		// Changes what is seen. It does not touch the page scroll: `go` takes care of that.
		private apply(target: number, options: GoOptions = {}): void {
			const { focus = false, syncHash = true, instant = false } = options;
			const { folder } = this.parts;
			const clamped = clampIndex(target, this.total);
			const changed = clamped !== this.page;
			this.page = clamped;
			if (focus) this.pendingFocus = clamped;

			if (instant) folder.dataset.instant = '';
			this.render(!instant);
			if (instant)
				afterPaint(() => folder.removeAttribute('data-instant'));

			if (changed && syncHash) this.syncHash();
		}

		private go(target: number, options: GoOptions = {}): void {
			const clamped = clampIndex(target, this.total);
			if (!this.scrollMode || options.instant || options.fromScroll) {
				this.apply(clamped, options);
				return;
			}

			// With scroll, going to a page means scrolling the page to it: the sheets turn along the way.
			this.preferred = clamped;
			if (options.focus) this.pendingFocus = clamped;
			// If it is already visible, the scroll would not change it: it is applied right away (it may be the other page of the spread).
			if (positionOfPage(clamped, this.layout) === this.position) {
				this.apply(clamped, options);
			}
			if (Math.abs(scrollY - this.offsetOf(clamped)) > 1) {
				this.scrollToPage(clamped, true);
			}
		}

		private turnTo(action: PagerAction): void {
			this.go(
				pageAtPosition(
					turn(this.position, action, this.count),
					this.total,
					this.layout,
				),
			);
		}

		private onLayoutChange(): void {
			const { folder } = this.parts;
			this.layout = this.wide.matches ? 'spread' : 'single';

			folder.dataset.instant = '';
			this.render(false);
			this.measure(true);
			afterPaint(() => folder.removeAttribute('data-instant'));
		}

		/**
		 * Entering through an anchor (`/#resume`, from an old link): the browser scrolls the page to
		 * the anchor's element, which here is inside the pinned folder, and may keep doing so
		 * while loading. When it finishes, the folder is put back where it belongs, unless the person
		 * has already started to move.
		 */
		private settleLanding(landed: number): void {
			this.preferred = landed;

			// While loading, the anchor has no element left to point to: this way the browser stops
			// jumping to it on its own (Firefox repeats it until loading ends), and the script is the one that places the
			// folder. Without JavaScript the id stays in the HTML, and here it is given back right away.
			const anchor = document.getElementById(location.hash.slice(1));
			const id = anchor?.id;
			anchor?.removeAttribute('id');
			setTimeout(() => {
				if (anchor && id) anchor.id = id;
			}, LANDING_WINDOW);

			let moved = false;
			for (const type of [
				'wheel',
				'touchstart',
				'pointerdown',
				'keydown',
			]) {
				addEventListener(
					type,
					() => {
						moved = true;
					},
					{ once: true, passive: true },
				);
			}
			const place = () => {
				if (moved || !this.scrollMode) return;
				if (Math.abs(scrollY - this.offsetOf(landed)) > 1) {
					this.scrollToPage(landed, false);
				}
			};
			if (document.readyState === 'complete') {
				requestAnimationFrame(place);
			} else {
				addEventListener('load', () => requestAnimationFrame(place), {
					once: true,
				});
			}
			void document.fonts.ready.then(place);

			// Firefox may finish its smooth scroll to the anchor after all of that: for a while,
			// every time a scroll ends it is checked that the folder is still where it belongs.
			addEventListener('scrollend', place);
			setTimeout(
				() => removeEventListener('scrollend', place),
				LANDING_WINDOW,
			);
		}

		private listen(): void {
			const { folder, viewport, spread, bar, turners } = this.parts;

			for (const button of turners) {
				button.addEventListener('click', () =>
					this.turnTo(
						button.dataset.turn === 'prev' ? 'prev' : 'next',
					),
				);
			}
			folder.addEventListener('keydown', (event) => this.onKey(event));
			this.listenToFingers(viewport);
			document.addEventListener('click', (event) =>
				this.onLinkClick(event),
			);
			addEventListener('hashchange', () => this.onHash());

			// Whoever moves the page by hand again is no longer waiting for the sheet requested earlier.
			const forget = () => {
				this.pendingFocus = null;
				this.preferred = null;
			};
			addEventListener('wheel', forget, { passive: true });
			addEventListener('touchstart', forget, { passive: true });

			// Any command from the person cuts short whatever the folder was scrolling on its own. In the
			// capture phase: so it runs before whoever asks for another scroll (the click of a tab).
			for (const type of [
				'wheel',
				'touchstart',
				'pointerdown',
				'keydown',
			]) {
				addEventListener(
					type,
					() => {
						this.heading = null;
					},
					{ capture: true, passive: true },
				);
			}
			// With a finger resting the scroll is not stopped even if it does not move; when it is lifted, it settles.
			addEventListener(
				'touchstart',
				() => {
					this.holding = true;
				},
				{ passive: true },
			);
			for (const type of ['touchend', 'touchcancel']) {
				addEventListener(
					type,
					(event) => {
						this.holding = (event as TouchEvent).touches.length > 0;
						if (!this.holding) this.scheduleSettle();
					},
					{ passive: true },
				);
			}

			addEventListener(
				'scroll',
				throttled(() => this.onScroll()),
				{
					passive: true,
				},
			);
			if (HAS_SCROLLEND)
				addEventListener('scrollend', () => this.settle());
			const remeasure = throttled(() => this.measure());
			addEventListener('resize', remeasure);
			this.wide.addEventListener('change', () => this.onLayoutChange());
			// Fonts and images change the height of the sheets after painting.
			const sizes = new ResizeObserver(remeasure);
			sizes.observe(spread);
			if (bar) sizes.observe(bar);
			void document.fonts.ready.then(remeasure);
		}

		// Keys turn sheets with focus on the folder or on the page being read, not on a link inside it.
		private onKey(event: KeyboardEvent): void {
			if (
				event.altKey ||
				event.ctrlKey ||
				event.metaKey ||
				event.shiftKey
			)
				return;
			const target = event.target as Element;
			const page = target.closest('[data-page]');
			if ((page && page !== target) || target.closest('button')) return;

			const action = keyAction(event.key);
			if (!action) return;

			event.preventDefault();
			this.turnTo(action);
		}

		// Swiping a finger sideways, or tapping an edge, turns the sheet. Not with a mouse: that is how text gets selected.
		private listenToFingers(viewport: HTMLElement): void {
			let start: { x: number; y: number } | null = null;
			viewport.addEventListener('pointerdown', (event) => {
				if (event.pointerType === 'mouse') return;
				if ((event.target as Element).closest('a, button')) return;
				start = { x: event.clientX, y: event.clientY };
			});
			viewport.addEventListener('pointerup', (event) => {
				if (!start) return;

				const box = viewport.getBoundingClientRect();
				const action = gestureAction(
					event.clientX - start.x,
					event.clientY - start.y,
					event.clientX - box.left,
					box.width,
				);
				start = null;
				if (action) this.turnTo(action);
			});
			viewport.addEventListener('pointercancel', () => {
				start = null;
			});
		}

		private onLinkClick(event: MouseEvent): void {
			if (event.defaultPrevented || event.button !== 0) return;
			if (
				event.altKey ||
				event.ctrlKey ||
				event.metaKey ||
				event.shiftKey
			)
				return;

			const link = (event.target as Element).closest<HTMLAnchorElement>(
				'a[href^="#"]',
			);
			const target = link ? indexForHash(link.hash, this.plan) : null;
			if (!link || target === null) return;

			event.preventDefault();
			// Pressing again the tab of the section you are already in does not fill the history.
			if (link.hash !== location.hash)
				history.pushState(null, '', link.hash);
			this.go(target, { focus: true, syncHash: false });
			if (!this.scrollMode) this.reveal();
		}

		// "Back" and "Forward" between anchors, also to the address without an anchor, which is the cover.
		private onHash(): void {
			const target = pageForHash(location.hash, this.plan);
			if (target === null) return;

			this.go(target, { focus: target > 0, syncHash: false });
			if (!this.scrollMode) this.reveal();
		}
	}

	for (const folder of document.querySelectorAll<HTMLElement>(
		'[data-folder]',
	)) {
		const parts = findParts(folder);
		if (parts) new FolderView(parts).start();
	}
</script>
