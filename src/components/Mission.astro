---
import { localize } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import type { Project } from '../lib/schemas';
import { fill } from '../lib/text';
import { t } from '../lib/ui';
import Sheet from './Sheet.astro';

interface Props {
	project: Project;
	locale: Locale;
	tilt?: number;
}

const { project, locale, tilt = 0.8 } = Astro.props;
const titleId = `mission-${project.id}`;
---

<Sheet as="article" {tilt} labelledby={titleId}>
	<div class="coupon">
		<svg
			class="scissors"
			viewBox="0 0 24 24"
			width="26"
			height="26"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			aria-hidden="true"
			focusable="false"
		>
			<circle cx="6" cy="6" r="3"></circle>
			<circle cx="6" cy="18" r="3"></circle>
			<path d="M8.5 7.5 21 18M8.5 16.5 21 6"></path>
		</svg>

		<h3 id={titleId} class="name">
			{project.name}
		</h3>
		<p>{localize(project.summary, locale)}</p>
		<p class="stack">{project.stack.join(', ')}</p>
		<a
			class="link"
			href={project.repo}
			aria-label={fill(t(locale, 'mission.repoLabel'), {
				name: project.name,
			})}
		>
			{t(locale, 'mission.repo')}
		</a>
	</div>
</Sheet>

<style>
	/* Cupón de racionamiento: borde de corte y unas tijeras sobre la línea. */
	.coupon {
		position: relative;
		display: grid;
		gap: var(--space-2);
		padding: var(--space-4);
		border: 2px dashed var(--rule);
	}

	.scissors {
		position: absolute;
		top: -0.9rem;
		left: var(--space-4);
		color: var(--ink-muted);
	}

	.name {
		font-size: var(--text-h3);
	}

	.stack {
		font-size: var(--text-sm);
		font-style: italic;
		color: var(--ink-muted);
	}

	.link {
		justify-self: start;
		margin-top: var(--space-1);
		font-weight: 700;
	}
</style>
