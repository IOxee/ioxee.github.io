---
import { yearRange } from '../lib/age';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/ui';

interface Props {
	name: string;
	startYear: number;
	locale: Locale;
}

const { name, startYear, locale } = Astro.props;
---

<footer class="footer">
	<div class="inner">
		<p>
			© {yearRange(startYear)} {name}. {t(locale, 'footer.rights')}.
		</p>
	</div>
</footer>

<style>
	/* Fixed minimum height: the script measures it, and the folder knows how much is left for it before measuring. */
	.footer {
		display: flex;
		align-items: center;
		min-height: var(--foot-h);
		font-size: var(--text-sm);
		line-height: 1.35;
		background: var(--desk);
		border-top: 1px solid
			color-mix(in oklch, var(--on-desk) 22%, transparent);
	}

	.inner {
		width: min(100% - 2 * var(--gutter), var(--page-width));
		margin-inline: auto;
		padding-block: var(--space-1);
	}
</style>
