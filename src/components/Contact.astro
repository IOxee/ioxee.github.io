---
import type { Locale } from '../lib/i18n';
import type { Profile } from '../lib/schemas';
import { t } from '../lib/ui';
import { displayUrl } from '../lib/url';
import Leaders from './Leaders.astro';
import Sheet from './Sheet.astro';

interface Props {
	profile: Profile;
	locale: Locale;
}

const { profile, locale } = Astro.props;
const { email, github, linkedin } = profile.links;

const items = [
	{
		label: t(locale, 'contact.email'),
		value: email,
		href: `mailto:${email}`,
	},
	{
		label: t(locale, 'contact.github'),
		value: displayUrl(github),
		href: github,
	},
	{
		label: t(locale, 'contact.linkedin'),
		value: displayUrl(linkedin),
		href: linkedin,
	},
];
---

<div class="wrap">
	<Sheet as="section" tilt={-0.4} labelledby="contact-title">
		<h2 id="contact-title" class="title">
			{t(locale, 'section.contact')}
		</h2>
		<Leaders items={items} />
	</Sheet>
</div>

<style>
	/* Tres filas no necesitan todo el ancho: unos puntos guía de un metro no se leen como una ficha. */
	.wrap {
		max-width: 38rem;
	}

	.title {
		margin-bottom: var(--space-3);
		font-size: var(--text-h2);
	}
</style>
