---
import type { SheetKind } from '../lib/folder';
import type { SectionId } from '../lib/sections';

interface Props {
	kind: SheetKind;
	section: SectionId;
	/** It is the first page of its section: it carries the anchor id. */
	anchor?: boolean;
	title: string;
	labelledby: string;
	/** It is the one seen on load. The script places the rest. */
	current?: boolean;
	face?: 'front' | 'back';
	tilt?: number;
}

const {
	kind,
	section,
	anchor = false,
	title,
	labelledby,
	current = false,
	face = 'front',
	tilt = 0,
} = Astro.props;

const variant = kind === 'cover' ? 'cover' : 'sheet';
---

{/* The initial state goes in the HTML so the first paint is already the right one; the script does the rest. */}
<section
	class:list={['page', `page--${variant}`, `page--${face}`]}
	id={anchor ? section : undefined}
	data-page
	data-kind={kind}
	data-section={section}
	data-anchor={anchor}
	data-title={title}
	data-state={current ? 'current' : 'future'}
	data-near={current ? '' : undefined}
	aria-labelledby={labelledby}
	style={`--tilt: ${tilt}deg`}
>
	<slot />
	{/* The number appears on its own, counting content pages: the cover has none. */}
	{variant === 'sheet' && <p class="folio" aria-hidden="true" />}
</section>
