---
interface Props {
	/** Position of the sheet in the folder: 0 is the cover. */
	index: number;
}

const { index } = Astro.props;
---

{/* A physical sheet: the front face and the back face. The pages are the ones that carry the content. */}
<div
	class:list={['leaf', { 'leaf--cover': index === 0 }]}
	data-leaf
	data-near={index <= 1 ? '' : undefined}
>
	<slot name="front" />
	<slot name="back">
		{/* Nothing to show: the inside of the cover or the blank back of the last sheet. */}
		<div class="page page--back page--blank" aria-hidden="true"></div>
	</slot>
</div>
