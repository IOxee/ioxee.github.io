---
import { existsSync, readdirSync } from 'node:fs';
import { join, relative } from 'node:path';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/avatar.png';
import Base from '../layouts/Base.astro';
import { sortExperience } from '../lib/experience';
import { folderTabs, planSheets, sheetTitles } from '../lib/folder';
import type { FolderData } from '../lib/folder-data';
import { DEFAULT_LOCALE, LOCALES } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import {
	assertAssetsUsed,
	assertProjectAssetsUsed,
	pickOptionalAsset,
	pickProjectDocument,
} from '../lib/images';
import { sortByOrder, sortNewestFirst } from '../lib/order';
import { SECTION_IDS, type SectionId } from '../lib/sections';
import { absoluteUrl, personSeoFrom, siteJsonLd } from '../lib/seo';
import { groupSkills } from '../lib/skills';
import { fill } from '../lib/text';
import { t } from '../lib/ui';
import { displayUrl } from '../lib/url';
import DocumentViewer from './DocumentViewer.astro';
import FolderBook from './FolderBook.astro';
import SiteFooter from './SiteFooter.astro';
import SiteNav from './SiteNav.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

/** First year of the copyright, inherited from the v1 site. */
const COPYRIGHT_FROM = 2019;

const [profileEntry] = await getCollection('profile');
if (!profileEntry) throw new Error('Falta el perfil en src/data/profile.yaml');
const profile = profileEntry.data;

const experience = sortExperience(
	(await getCollection('experience')).map((entry) => entry.data),
);
const skills = (await getCollection('skills')).map((entry) => entry.data);
const { email, github, linkedin } = profile.links;

// What is attached to a certification (its photo and its document) goes in src/assets/certifications/ and
// is named after its `id`. Without a file nothing appears: nothing needs to be declared in the YAML.
// A project has its own folder, src/assets/projects/<id>/, with its screenshot (image.png) and its optional
// document (document.pdf, and document.<locale>.pdf for each translation).
const ATTACHMENT_EXTENSIONS = ['png', 'jpg', 'jpeg', 'webp', 'pdf'];
const attachmentsIn = (folder: string): string[] => {
	const path = join(process.cwd(), folder);

	return existsSync(path)
		? readdirSync(path).filter((name) => !name.startsWith('.'))
		: [];
};
const certificationImages = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/certifications/*.{png,jpg,jpeg,webp}',
	{ eager: true },
);
// `no-inline`: a small PDF would be embedded as `data:` in the link, and browsers do not open those.
const certificationDocuments = import.meta.glob<string>(
	'../assets/certifications/*.pdf',
	{ query: '?url&no-inline', import: 'default', eager: true },
);
const projectDocuments = import.meta.glob<string>(
	'../assets/projects/*/document*.pdf',
	{ query: '?url&no-inline', import: 'default', eager: true },
);
// Every file under src/assets/projects/<id>/, as `<id>/<name>`.
const projectFiles = (): string[] => {
	const path = join(process.cwd(), 'src/assets/projects');
	if (!existsSync(path)) return [];

	return readdirSync(path, { recursive: true, withFileTypes: true })
		.filter((entry) => entry.isFile() && !entry.name.startsWith('.'))
		.map((entry) =>
			join(relative(path, entry.parentPath), entry.name).replaceAll(
				'\\',
				'/',
			),
		);
};
const certificationList = sortByOrder(
	(await getCollection('certifications')).map((entry) => entry.data),
);
const projectList = sortNewestFirst(
	(await getCollection('projects')).map((entry) => entry.data),
);

// A misnamed file would go unused and not say why: better for the build to warn.
assertAssetsUsed({
	folder: 'src/assets/certifications',
	files: attachmentsIn('src/assets/certifications'),
	ids: certificationList.map((entry) => entry.id),
	extensions: ATTACHMENT_EXTENSIONS,
	owner: 'una certificación de certifications.yaml',
});
assertProjectAssetsUsed(
	projectFiles(),
	projectList.map((entry) => entry.id),
	LOCALES.filter((entry) => entry !== DEFAULT_LOCALE),
);

// `getCollection` does not keep the file's order: whatever needs it is sorted by `order`.
const data: FolderData = {
	profile,
	work: experience.filter((entry) => entry.kind === 'work'),
	education: experience.filter((entry) => entry.kind === 'education'),
	skillGroups: groupSkills(skills),
	languages: sortByOrder(
		(await getCollection('languages')).map((entry) => entry.data),
	),
	certifications: certificationList.map((entry) => ({
		...entry,
		image: pickOptionalAsset(certificationImages, entry.id)?.default,
		document: pickOptionalAsset(certificationDocuments, entry.id),
	})),
	projects: projectList.map((entry) => ({
		...entry,
		document: pickProjectDocument(projectDocuments, entry.id, locale),
	})),
	contact: [
		{
			label: t(locale, 'contact.email'),
			value: email,
			href: `mailto:${email}`,
		},
		{
			label: t(locale, 'contact.github'),
			value: displayUrl(github),
			href: github,
		},
		{
			label: t(locale, 'contact.linkedin'),
			value: displayUrl(linkedin),
			href: linkedin,
		},
	],
};

const plan = planSheets({
	experience: data.work.length,
	education: data.education.length,
	skillGroups: data.skillGroups.length,
	languages: data.languages.length,
	certifications: data.certifications.length,
	projects: data.projects.length,
	detailedProjects: data.projects.flatMap((project, index) =>
		project.details ? [index] : [],
	),
	photographedCertifications: data.certifications.flatMap((cert, index) =>
		cert.image ? [index] : [],
	),
});

const titles = sheetTitles(plan, {
	labels: {
		cover: profile.name,
		about: t(locale, 'section.about'),
		experience: t(locale, 'section.experience'),
		education: t(locale, 'section.education'),
		skills: t(locale, 'section.skills'),
		certifications: t(locale, 'section.certifications'),
		project: t(locale, 'section.projects'),
		'project-details': t(locale, 'section.projects'),
		contact: t(locale, 'section.contact'),
	},
	projectNames: data.projects.map((project) => project.name),
	partTemplate: t(locale, 'folder.part'),
});

const TAB_LABEL: Record<SectionId, string> = {
	[SECTION_IDS.home]: profile.name,
	[SECTION_IDS.about]: t(locale, 'nav.about'),
	[SECTION_IDS.resume]: t(locale, 'nav.resume'),
	[SECTION_IDS.certifications]: t(locale, 'nav.certifications'),
	[SECTION_IDS.projects]: t(locale, 'nav.projects'),
	[SECTION_IDS.contact]: t(locale, 'nav.contact'),
};
const tabs = folderTabs(plan).map(({ section }) => ({
	section,
	label: TAB_LABEL[section],
}));

const title = fill(t(locale, 'meta.title'), { name: profile.name });
const description = fill(t(locale, 'meta.description'), { name: profile.name });
const imageAlt = fill(t(locale, 'meta.imageAlt'), { name: profile.name });
// In the structured data the image is the person's; the sharing one goes in Base's metas.
const portrait = await getImage({ src: avatar, width: 512, format: 'webp' });
const jsonLd = siteJsonLd(
	personSeoFrom({
		profile,
		experience,
		skills,
		locale,
		url: absoluteUrl(Astro.url.pathname, Astro.site),
		image: absoluteUrl(portrait.src, Astro.site),
	}),
	locale,
);
---

<Base
	title={title}
	description={description}
	siteName={profile.name}
	imageAlt={imageAlt}
	jsonLd={jsonLd}
	locale={locale}
>
	<SiteNav locale={locale} tabs={tabs} />

	<main id="contenido" class="page">
		<FolderBook plan={plan} titles={titles} data={data} locale={locale} />
	</main>

	<SiteFooter
		name={profile.name}
		startYear={COPYRIGHT_FROM}
		locale={locale}
	/>

	{(data.certifications.some((cert) => cert.image || cert.document) ||
		data.projects.some((project) => project.document)) && (
		<DocumentViewer locale={locale} />
	)}
</Base>

<style>
	.page {
		width: 100%;
		padding-inline: var(--gutter);
	}
</style>
