---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sortExperience } from '../lib/experience';
import type { Locale } from '../lib/i18n';
import { pickImage } from '../lib/images';
import { sortByOrder } from '../lib/order';
import { partialDateKey } from '../lib/partial-date';
import { SECTION_IDS } from '../lib/sections';
import { groupSkills } from '../lib/skills';
import { fill } from '../lib/text';
import { t } from '../lib/ui';
import About from './About.astro';
import Cartilla from './Cartilla.astro';
import Contact from './Contact.astro';
import Inventory from './Inventory.astro';
import Languages from './Languages.astro';
import Mission from './Mission.astro';
import ServiceRecord from './ServiceRecord.astro';
import SiteFooter from './SiteFooter.astro';
import SiteNav from './SiteNav.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

/** Primer año del copyright, heredado del sitio v1. */
const COPYRIGHT_FROM = 2019;
/** Cada cupón cae con un giro distinto. */
const MISSION_TILTS = [0.8, -0.6, 0.45];

const [profileEntry] = await getCollection('profile');
if (!profileEntry) throw new Error('Falta el perfil en src/data/profile.yaml');
const profile = profileEntry.data;

const experience = sortExperience(
	(await getCollection('experience')).map((entry) => entry.data),
);
const work = experience.filter((entry) => entry.kind === 'work');
const education = experience.filter((entry) => entry.kind === 'education');
// La cartilla se "expide" el año del primer registro de la trayectoria.
const issuedYear = Math.floor(
	Math.min(
		...experience.map((entry) => partialDateKey(entry.start, 'start')),
	) / 100,
);

const groups = groupSkills(
	(await getCollection('skills')).map((entry) => entry.data),
);
// `getCollection` no conserva el orden del archivo: proyectos e idiomas se ordenan por `order`.
const projects = sortByOrder(
	(await getCollection('projects')).map((entry) => entry.data),
);
const languages = sortByOrder(
	(await getCollection('languages')).map((entry) => entry.data),
);

// La captura de cada proyecto se llama como su id: `src/assets/projects/<id>.png`.
const projectImages = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/projects/*.{png,jpg,jpeg,webp}',
	{ eager: true },
);
const projectImage = (id: string) => pickImage(projectImages, id).default;

const title = fill(t(locale, 'meta.title'), { name: profile.name });
const description = fill(t(locale, 'meta.description'), { name: profile.name });
---

<Base title={title} description={description} locale={locale}>
	<SiteNav locale={locale} />

	<main id="contenido" class="page">
		<div id={SECTION_IDS.home}>
			<Cartilla
				profile={profile}
				issuedYear={issuedYear}
				locale={locale}
			/>
		</div>

		<div id={SECTION_IDS.about}>
			<About profile={profile} locale={locale} />
		</div>

		<div id={SECTION_IDS.resume} class="resume">
			<div class="column">
				<ServiceRecord
					title={t(locale, 'section.experience')}
					titleId="experience-title"
					entries={work}
					locale={locale}
				/>
				<ServiceRecord
					title={t(locale, 'section.education')}
					titleId="education-title"
					entries={education}
					locale={locale}
					tilt={-0.4}
				/>
			</div>
			<div class="column column--offset">
				<Inventory groups={groups} locale={locale} />
				<Languages languages={languages} locale={locale} />
			</div>
		</div>

		<section id={SECTION_IDS.projects} aria-labelledby="projects-title">
			<h2 id="projects-title" class="desk-title">
				{t(locale, 'section.projects')}
			</h2>
			<div class="missions">
				{projects.map((project, index) => (
					<Mission
						project={project}
						image={projectImage(project.id)}
						locale={locale}
						tilt={MISSION_TILTS[index % MISSION_TILTS.length]}
					/>
				))}
			</div>
		</section>

		<div id={SECTION_IDS.contact}>
			<Contact profile={profile} locale={locale} />
		</div>
	</main>

	<SiteFooter
		name={profile.name}
		startYear={COPYRIGHT_FROM}
		locale={locale}
	/>
</Base>

<style>
	.page {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-7);
		width: min(100% - 2 * var(--gutter), var(--page-width));
		margin: var(--space-5) auto 0;
		padding-bottom: var(--space-6);
	}

	.resume {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-5);
		align-items: start;
	}

	.column {
		display: grid;
		gap: var(--space-5);
	}

	.desk-title {
		margin-bottom: var(--space-4);
		font-size: var(--text-h2);
		color: var(--on-desk);
	}

	.missions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
		gap: var(--space-5);
		align-items: start;
	}

	@media (min-width: 48rem) {
		/* La barra de navegación es fija: las anclas dejan sitio para que no tape el título. */
		.page > :global(*) {
			scroll-margin-top: 5rem;
		}
	}

	@media (min-width: 72rem) {
		.resume {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		}

		/* Las dos columnas no arrancan a la misma altura: se nota que son papeles distintos. */
		.column--offset {
			margin-top: var(--space-5);
		}
	}
</style>
