---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { calculateAge } from '../lib/age';
import { localize } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import type { Profile } from '../lib/schemas';
import { fill } from '../lib/text';
import { formatYears, t } from '../lib/ui';
import Leaders from './Leaders.astro';
import Sheet from './Sheet.astro';
import Stamp from './Stamp.astro';

interface Props {
	profile: Profile;
	/** Año del primer registro de la trayectoria: la cartilla se "expide" cuando empezó todo. */
	issuedYear: number;
	locale: Locale;
}

const { profile, issuedYear, locale } = Astro.props;

const fields = [
	{
		label: t(locale, 'card.trade'),
		value: localize(profile.headline, locale),
	},
	{
		label: t(locale, 'card.base'),
		value: localize(profile.location, locale),
	},
	{
		label: t(locale, 'card.age'),
		value: formatYears(calculateAge(profile.birthDate), locale),
	},
	{ label: t(locale, 'card.issued'), value: String(issuedYear) },
];

const photoAlt = fill(t(locale, 'card.photoAlt'), { name: profile.name });
const stampText = t(locale, 'card.stamp');
---

<Sheet as="section" perforated tilt={-0.6} labelledby="cartilla-name">
	<div class="grid">
		<p class="doc">{t(locale, 'card.title')}</p>

		<div class="photo-wrap">
			<figure class="photo">
				<Image
					src={avatar}
					alt={photoAlt}
					width={420}
					height={420}
					loading="eager"
					fetchpriority="high"
				/>
			</figure>
			{/* En pantallas anchas el sello cuelga de la foto, sobre el papel, donde se lee. */}
			<div class="stamp-photo">
				<Stamp text={stampText} tilt={-9} animate />
			</div>
		</div>

		<div class="identity">
			<h1 id="cartilla-name" class="name">
				{profile.name}
			</h1>
			{/* En móvil no hay sitio junto a la foto: el sello va bajo el nombre. */}
			<div class="stamp-inline">
				<Stamp text={stampText} tilt={-7} animate />
			</div>
		</div>

		<div class="fields">
			<Leaders items={fields} />
		</div>
	</div>
</Sheet>

<style>
	.grid {
		position: relative;
		display: grid;
		grid-template-columns: 5.75rem minmax(0, 1fr);
		grid-template-areas:
			'doc doc'
			'photo name'
			'fields fields';
		gap: var(--space-3) var(--space-4);
		align-items: start;
	}

	/* La cabecera del documento, entre dos pautas como en las cartillas impresas. */
	.doc {
		grid-area: doc;
		max-width: none;
		padding-block: 0.3rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-lg);
		border-block: 3px double var(--ink);
	}

	.photo-wrap {
		grid-area: photo;
		position: relative;
	}

	.photo {
		position: relative;
		margin: 0;
		padding: 0.4rem;
		background: var(--paper-shade);
		box-shadow:
			0 2px 0 oklch(0% 0 0 / 0.18),
			0 7px 10px oklch(0% 0 0 / 0.25);
		transform: rotate(-2deg);
	}

	.photo::before {
		content: '';
		position: absolute;
		top: -0.65rem;
		left: 50%;
		z-index: 1;
		width: 4.5rem;
		height: 1.4rem;
		background: color-mix(in oklch, var(--tape) 82%, transparent);
		box-shadow: 0 1px 2px oklch(0% 0 0 / 0.25);
		translate: -50% 0;
		rotate: -4deg;
	}

	.identity {
		grid-area: name;
		display: grid;
		gap: var(--space-2);
		justify-items: start;
		align-self: center;
		min-width: 0;
	}

	.name {
		font-size: var(--text-hero);
		overflow-wrap: anywhere;
	}

	.fields {
		grid-area: fields;
	}

	.stamp-photo {
		display: none;
		position: absolute;
		right: calc(var(--space-4) * -1);
		bottom: -2.6rem;
		z-index: 2;
	}

	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: clamp(13rem, 18vw, 16rem) minmax(0, 1fr);
			grid-template-areas:
				'doc doc'
				'photo name'
				'photo fields';
			column-gap: var(--space-5);
			row-gap: var(--space-4);
			/* Sitio para la parte del sello que cuelga por debajo de la foto. */
			padding-bottom: var(--space-4);
		}

		.identity {
			align-self: end;
		}

		.stamp-inline {
			display: none;
		}

		.stamp-photo {
			display: block;
		}
	}
</style>
