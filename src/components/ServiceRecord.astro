---
import { formatPeriod } from '../lib/experience';
import { localize } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import type { ExperienceEntry } from '../lib/schemas';
import { t } from '../lib/ui';
import Sheet from './Sheet.astro';

interface Props {
	/** Ya ordenadas con `sortExperience`: este componente no reordena. */
	entries: readonly ExperienceEntry[];
	locale: Locale;
	title: string;
	/** Id del título: `Sheet` lo usa como nombre accesible de la sección. */
	titleId: string;
	tilt?: number;
}

const { entries, locale, title, titleId, tilt = 0.35 } = Astro.props;
const presentLabel = t(locale, 'period.present');
---

<Sheet as="section" {tilt} labelledby={titleId}>
	<h2 id={titleId} class="title">
		{title}
	</h2>

	<ol class="record" role="list">
		{entries.map((entry) => (
			<li class="entry">
				<p class="period">
					{formatPeriod(entry.start, entry.end, presentLabel)}
				</p>
				<div>
					<h3 class="role">{localize(entry.role, locale)}</h3>
					{entry.organization && (
						<p class="org">{entry.organization}</p>
					)}
					<p>{localize(entry.summary, locale)}</p>
				</div>
			</li>
		))}
	</ol>
</Sheet>

<style>
	.title {
		margin-bottom: var(--space-4);
		font-size: var(--text-h2);
	}

	.record {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Una pauta gruesa abre el registro y un punteado separa cada anotación. */
	.entry {
		display: grid;
		gap: var(--space-1) var(--space-4);
		padding-block: var(--space-3);
		border-top: 1px dotted var(--rule);
	}

	.entry:first-child {
		border-top: 2px solid var(--ink);
	}

	.period {
		font-size: var(--text-sm);
		color: var(--ink-muted);
	}

	.role {
		font-size: var(--text-h3);
	}

	.org {
		font-style: italic;
		color: var(--ink-muted);
	}

	@media (min-width: 40rem) {
		.entry {
			grid-template-columns: 11rem 1fr;
		}
	}
</style>
