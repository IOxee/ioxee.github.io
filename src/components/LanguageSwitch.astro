---
import { LANGUAGES, type Locale, localePath } from '../lib/i18n';
import { t } from '../lib/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

{/*
	Three languages, not a switch. They are links to the same page in each language (a static site does not change
	language in place): they work without JavaScript and search engines follow them. The accessible name is the language written
	in itself, with its `lang`.
*/}
<div
	class="lang"
	role="group"
	aria-label={t(locale, 'lang.label')}
	data-lang-switch
>
	<ul role="list">
		{LANGUAGES.map((language) => (
			<li>
				<a
					href={localePath(language.locale)}
					lang={language.locale}
					hreflang={language.locale}
					aria-label={language.name}
					aria-current={
						language.locale === locale ? 'page' : undefined
					}
				>
					{language.label}
				</a>
			</li>
		))}
	</ul>
</div>

<script>
	// When switching language, the sheet being read is kept: the folder leaves its section in the
	// address anchor (`#resume`…), which is the same in the three languages.
	const group = document.querySelector('[data-lang-switch]');
	const links = group?.querySelectorAll<HTMLAnchorElement>('a') ?? [];

	const keepSection = () => {
		for (const link of links) link.hash = location.hash;
	};
	for (const type of ['pointerdown', 'focusin', 'keydown']) {
		group?.addEventListener(type, keepSection, { passive: true });
	}
</script>

<style>
	ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--paper);
		border: 2px solid var(--ink);
		border-radius: 0.2rem;
		box-shadow: 0 3px 0 oklch(0% 0 0 / 0.35);
	}

	li + li {
		border-left: 2px solid var(--ink);
	}

	a {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.5rem;
		/* Height of the theme button: 2.75rem minus its two 2px borders. */
		min-height: calc(2.75rem - 4px);
		padding-inline: 0.4rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		color: var(--ink);
		text-decoration: none;
	}

	a:hover {
		background: color-mix(in oklch, var(--ink) 14%, var(--paper));
	}

	a[aria-current='page'] {
		color: var(--paper);
		background: var(--ink);
	}

	/* The Tab-key focus halo has to sit above its neighbours. */
	a:focus-visible {
		z-index: 1;
	}

	@media (forced-colors: active) {
		a[aria-current='page'] {
			text-decoration: underline;
			text-decoration-thickness: 3px;
			text-underline-offset: 0.3em;
		}
	}
</style>
