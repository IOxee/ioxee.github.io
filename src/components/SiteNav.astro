---
import type { Locale } from '../lib/i18n';
import type { SectionId } from '../lib/sections';
import { t } from '../lib/ui';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Tab {
	section: SectionId;
	label: string;
}

interface Props {
	locale: Locale;
	tabs: readonly Tab[];
}

const { locale, tabs } = Astro.props;
---

<header class="bar" data-site-bar>
	<div class="inner">
		<nav aria-label={t(locale, 'nav.label')} data-site-nav>
			<ul class="links" role="list">
				{tabs.map((tab) => (
					<li>
						<a href={`#${tab.section}`}>{tab.label}</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="tools">
			<LanguageSwitch locale={locale} />
			<ThemeToggle locale={locale} />
		</div>
	</div>
</header>

<style>
	.bar {
		position: sticky;
		top: 0;
		z-index: 5;
		height: var(--bar-h);
		background: var(--desk);
		border-bottom: 1px solid
			color-mix(in oklch, var(--on-desk) 16%, transparent);
	}

	.inner {
		display: flex;
		flex-wrap: nowrap;
		gap: var(--space-3);
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2 * var(--gutter), var(--page-width));
		height: 100%;
		margin-inline: auto;
	}

	/*
	 * En pantallas estrechas el menú se desliza de lado, y un contenedor que se desliza recorta lo
	 * que sale de él: el relleno deja sitio al anillo de foco de las pestañas y el margen negativo lo
	 * compensa para que el menú no ocupe más.
	 */
	nav {
		flex: 1;
		min-width: 0;
		margin: -0.75rem;
		padding: 0.75rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	nav::-webkit-scrollbar {
		display: none;
	}

	.tools {
		display: flex;
		flex: none;
		gap: var(--space-2);
		align-items: center;
	}

	.links {
		display: flex;
		flex-wrap: nowrap;
		gap: 0 var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		color: var(--on-desk);
		text-decoration: none;
		white-space: nowrap;
		border-bottom: 3px solid transparent;
	}

	.links a:hover {
		border-bottom-color: color-mix(
			in oklch,
			var(--on-desk) 55%,
			transparent
		);
	}

	.links a[aria-current] {
		border-bottom-color: var(--tape);
	}

	@media (min-width: 48rem) {
		.links {
			column-gap: var(--space-4);
		}

		.links a {
			font-size: var(--text-lg);
		}
	}

	@media (forced-colors: active) {
		.links a[aria-current] {
			text-decoration: underline;
			text-decoration-thickness: 3px;
			text-underline-offset: 0.3em;
		}
	}
</style>
