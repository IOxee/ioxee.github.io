---
import type { Locale } from '../lib/i18n';
import type { SectionId } from '../lib/sections';
import { t } from '../lib/ui';
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Tab {
	section: SectionId;
	label: string;
}

interface Props {
	locale: Locale;
	tabs: readonly Tab[];
}

const { locale, tabs } = Astro.props;
---

<header class="bar" data-site-bar>
	<div class="inner">
		<nav aria-label={t(locale, 'nav.label')} data-site-nav>
			<ul class="links" role="list">
				{tabs.map((tab) => (
					<li>
						<a href={`#${tab.section}`}>{tab.label}</a>
					</li>
				))}
			</ul>
		</nav>
		<div class="tools">
			<LanguageSwitch locale={locale} />
			<ThemeToggle locale={locale} />
		</div>
	</div>
</header>

<script>
	// Which edges of the menu hide tabs: the CSS fades them. The folder slides the menu to the tab of the section being read.
	for (const nav of document.querySelectorAll<HTMLElement>(
		'[data-site-nav]',
	)) {
		const mark = () => {
			const hidden = nav.scrollWidth - nav.clientWidth;
			nav.toggleAttribute('data-more-start', nav.scrollLeft > 1);
			nav.toggleAttribute('data-more-end', nav.scrollLeft < hidden - 1);
		};
		nav.addEventListener('scroll', mark, { passive: true });
		addEventListener('resize', mark);
		void document.fonts.ready.then(mark);
		mark();
	}
</script>

<style>
	.bar {
		position: sticky;
		top: 0;
		z-index: 5;
		height: var(--bar-h);
		background: var(--desk);
		border-bottom: 1px solid
			color-mix(in oklch, var(--on-desk) 16%, transparent);
	}

	.inner {
		display: flex;
		flex-wrap: nowrap;
		gap: var(--space-3);
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2 * var(--gutter), var(--page-width));
		height: 100%;
		margin-inline: auto;
	}

	/*
	 * On narrow screens the menu slides sideways, and a container that slides clips whatever
	 * sticks out of it: the padding leaves room for the tabs' focus ring and the negative margin
	 * compensates for it so the menu does not take up more space.
	 */
	nav {
		flex: 1;
		min-width: 0;
		margin: -0.75rem;
		padding: 0.75rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	nav::-webkit-scrollbar {
		display: none;
	}

	/* When the tabs do not fit, the edge where more of them are hidden fades out, instead of a word cut in half. */
	nav[data-more-end] {
		mask-image: linear-gradient(
			to right,
			#000 calc(100% - 2.5rem),
			transparent
		);
	}

	nav[data-more-start] {
		mask-image: linear-gradient(to right, transparent, #000 2.5rem);
	}

	nav[data-more-start][data-more-end] {
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 2.5rem,
			#000 calc(100% - 2.5rem),
			transparent
		);
	}

	.tools {
		display: flex;
		flex: none;
		gap: var(--space-2);
		align-items: center;
	}

	.links {
		display: flex;
		flex-wrap: nowrap;
		gap: 0 var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--text-sm);
		color: var(--on-desk);
		text-decoration: none;
		white-space: nowrap;
		border-bottom: 3px solid transparent;
	}

	.links a:hover {
		border-bottom-color: color-mix(
			in oklch,
			var(--on-desk) 55%,
			transparent
		);
	}

	.links a[aria-current] {
		border-bottom-color: var(--tape);
	}

	@media (min-width: 48rem) {
		.links {
			column-gap: var(--space-4);
		}

		.links a {
			font-size: var(--text-lg);
		}
	}

	@media (forced-colors: active) {
		.links a[aria-current] {
			text-decoration: underline;
			text-decoration-thickness: 3px;
			text-underline-offset: 0.3em;
		}
	}
</style>
